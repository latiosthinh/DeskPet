<Project Sdk="Microsoft.NET.Sdk">

  <!-- .NET Framework 4.8 ships with Windows 10 and 11, so DeskPet.exe runs with nothing to install. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>DeskPet</AssemblyName>
    <RootNamespace>DeskPet</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>DeskPet.ico</ApplicationIcon>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Version>1.2.0</Version>
    <Product>DeskPet</Product>
    <Description>A tiny pixel pet that lives on your taskbar</Description>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1587;CS1591</NoWarn>
    <CodeSecretFile>$(MSBuildThisFileDirectory)..\build\CodeSecret.cs</CodeSecretFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Generated by build.ps1 from ~/.config/deskpet/code-secret. Never committed. -->
    <Compile Include="$(CodeSecretFile)" Link="CodeSecret.cs" />
  </ItemGroup>

  <Target Name="CheckCodeSecret" BeforeTargets="CoreCompile">
    <Error Condition="!Exists('$(CodeSecretFile)')" Text="build\CodeSecret.cs is missing. Build with windows\build.ps1, which makes it." />
  </Target>

</Project>
