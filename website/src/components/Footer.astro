---
import { SITE } from '../lib/site';
---

<footer class="mt-16 border-t border-line">
  <div class="wrap flex flex-col gap-3 py-8 text-sm text-muted sm:flex-row sm:items-center sm:justify-between">
    <p class="m-0">DeskPet is free, with no ads and no tracking. Built by the DeskPet community.</p>
    <nav aria-label="Footer" class="flex flex-wrap gap-x-4 gap-y-2">
      <a class="inline-flex min-h-6 items-center font-semibold" href="/contribute/">
        Make a pet
      </a>
      <a class="inline-flex min-h-6 items-center font-semibold" href={SITE.repo} rel="noreferrer">
        Source on GitHub
      </a>
      <a class="inline-flex min-h-6 items-center font-semibold" href={SITE.release}>
        Download
      </a>
    </nav>
  </div>
</footer>
