---
import type { Pet } from '../lib/site';

interface Props {
  pet: Pet;
}

const { pet } = Astro.props;
---

<a class="card" href={`/pets/${pet.id}/`}>
  <span class="pet-frame pet-card-media">
    <img
      src={pet.hero.poster}
      width={pet.hero.width}
      height={pet.hero.height}
      alt=""
      loading="lazy"
      decoding="async"
    />
  </span>
  <span class="flex flex-col gap-1 p-3">
    <span class="flex flex-wrap items-center gap-2 text-lg font-bold leading-tight">
      {pet.name}
      {pet.builtin ? <span class="chip">Comes with the app</span> : null}
    </span>
    <span class="text-sm text-muted">
      {pet.trickCount} {pet.trickCount === 1 ? 'trick' : 'tricks'}
    </span>
  </span>
</a>
