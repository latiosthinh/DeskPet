---
import type { Pet } from '../lib/site';
import { INCLUDED_SHORT_LABEL } from '../lib/site';

interface Props {
  pet: Pet;
  template?: boolean;
}

const { pet, template = false } = Astro.props;
---

{template ? (
  <a class="card" data-card href="">
    <span class="media-frame frame-gallery">
      <img
        data-img
        width={pet.gallery.width}
        height={pet.gallery.height}
        alt=""
        loading="lazy"
        decoding="async"
        style={pet.gallery.zoom !== 1 ? `transform: scale(${pet.gallery.zoom})` : undefined}
      />
    </span>
    <span class="card-body">
      <span class="card-title" data-title />
      <span class="card-foot">
        <span class="card-meta" data-tricks />
        <span class="card-status">
          <span class="badge" data-badge hidden>
            {INCLUDED_SHORT_LABEL}
          </span>
          <span class="badge badge--outline" data-addon hidden>
            Free add-on
          </span>
        </span>
      </span>
    </span>
  </a>
) : (
  <a class="card" href={`/pets/${pet.id}/`}>
    <span class="media-frame frame-gallery">
      <img
        src={pet.gallery.src}
        width={pet.gallery.width}
        height={pet.gallery.height}
        alt=""
        loading="lazy"
        decoding="async"
        style={pet.gallery.zoom !== 1 ? `transform: scale(${pet.gallery.zoom})` : undefined}
      />
    </span>
    <span class="card-body">
      <span class="card-title" title={pet.name}>
        {pet.shortName}
      </span>
      <span class="card-foot">
        <span class="card-meta">
          {pet.trickCount} {pet.trickCount === 1 ? 'trick' : 'tricks'}
        </span>
        <span class="card-status">
          {pet.builtin ? (
            <span class="badge">{INCLUDED_SHORT_LABEL}</span>
          ) : (
            <span class="badge badge--outline">Free add-on</span>
          )}
        </span>
      </span>
    </span>
  </a>
)}
