---
import type { Pet } from '../lib/site';
import PetCard from './PetCard.astro';

interface Props {
  pets: Pet[];
  id?: string;
  compact?: boolean;
}

const { pets, id, compact = false } = Astro.props;
---

<ul class:list={['gallery-grid', { 'listing-grid': compact }]} id={id}>
  {pets.map((pet) => (
    <li>
      <PetCard pet={pet} />
    </li>
  ))}
</ul>
