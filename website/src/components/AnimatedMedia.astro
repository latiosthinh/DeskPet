---
import type { Media } from '../lib/site';

interface Props {
  media: Media;
  alt: string;
  name: string;
  eager?: boolean;
  frameClass?: string;
}

const { media, alt, name, eager = false, frameClass = '' } = Astro.props;
---

<div>
  <div
    class:list={['pet-frame', frameClass]}
    data-anim
    data-auto={eager ? 'eager' : 'visible'}
    data-name={name}
    data-playing="false"
  >
    <img
      src={media.poster}
      data-gif={media.src}
      data-poster={media.poster}
      width={media.width}
      height={media.height}
      alt={alt}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      fetchpriority={eager ? 'high' : 'auto'}
    />
  </div>
  <button
    type="button"
    class="anim-btn js-only mt-2"
    data-anim-toggle
    data-playing="false"
    aria-label={`Play ${name}`}
  >
    <span data-label>Play</span>
  </button>
</div>
