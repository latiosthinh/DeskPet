---
import type { GetStaticPaths } from 'astro';
import AnimatedMedia from '../../components/AnimatedMedia.astro';
import Base from '../../layouts/Base.astro';
import {
  INCLUDED_LABEL,
  SITE,
  absoluteUrl,
  authorSlug,
  categoryTitle,
  formatBytes,
  formatDuration,
  neighbors,
  petImageAlt,
  pets,
  type Pet,
} from '../../lib/site';

interface Props {
  pet: Pet;
}

export const getStaticPaths = (() =>
  pets.map((pet) => ({ params: { id: pet.id }, props: { pet } }))) satisfies GetStaticPaths;

const { pet } = Astro.props;
const path = `/pets/${pet.id}/`;
const category = categoryTitle(pet.category);
const authorAnchor = `/#author-${authorSlug(pet.author)}`;
const size = formatBytes(pet.fileSize);
const { previous, next } = neighbors(pet.id);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: pet.name,
  description: pet.description,
  url: absoluteUrl(path),
  image: absoluteUrl(pet.og),
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'macOS, Windows',
  softwareVersion: pet.version,
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  author: { '@type': 'Organization', name: pet.author },
  isPartOf: { '@type': 'SoftwareApplication', name: SITE.name, url: SITE.url },
};
---

<Base
  title={`${pet.name} · DeskPet`}
  description={pet.description}
  path={path}
  image={pet.og}
  schema={schema}
>
  <div class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/">All pets</a>
      <span aria-hidden="true">/</span>
      <a href={authorAnchor}>{pet.author}</a>
    </nav>

    <section class="pet-hero">
      <div class="panel pet-stage">
        <AnimatedMedia
          media={pet.hero}
          alt={petImageAlt(pet)}
          name={`${pet.name} the hero animation`}
          eager
          frameClass="frame-hero"
        />
      </div>

      <div class="pet-copy">
        <p class="badge">
          {category}
          {pet.builtin ? ` · ${INCLUDED_LABEL}` : ' · Add-on'}
        </p>
        <h1 class="page-title">{pet.name}</h1>
        <p class="lede">{pet.description}</p>

        <dl class="pet-meta">
          <div>
            <dt>Made by</dt>
            <dd>
              <a href={authorAnchor}>{pet.author}</a>
            </dd>
          </div>
          <div>
            <dt>Version</dt>
            <dd>{pet.version}</dd>
          </div>
          <div>
            <dt>Tricks</dt>
            <dd>{pet.trickCount}</dd>
          </div>
          {!pet.builtin && size ? (
            <div>
              <dt>File size</dt>
              <dd>{size}</dd>
            </div>
          ) : null}
        </dl>

        <div class="pet-action">
          {pet.builtin ? (
            <div class="included-box">
              <span class="badge">{INCLUDED_LABEL}</span>
              <p>
                {pet.shortName} is already inside DeskPet. <a href={SITE.release}>Get the app</a>{' '}
                and pick {pet.shortName} from the pet list.
              </p>
            </div>
          ) : (
            <div>
              <a
                class="btn btn-primary"
                href={`/download/${pet.id}`}
                download={`${pet.id}.deskpet`}
              >
                Download {pet.shortName}
              </a>
              <p class="fine-print">
                {pet.id}.deskpet{size ? ` · ${size}` : ''} · version {pet.version}
              </p>
            </div>
          )}
        </div>
      </div>
    </section>
  </div>

  <section class="wrap section" aria-labelledby="tricks">
    <div class="section-head">
      <div>
        <p class="eyebrow">Tricks</p>
        <h2 id="tricks" class="section-title">
          Every little move
        </h2>
      </div>
      <p class="fine-print">Each clip loops. Pause any of them, or pause them all up top.</p>
    </div>
    <ul class="trick-grid">
      {pet.tricks.map((trick) => (
        <li>
          <figure class="tile">
            <AnimatedMedia
              media={trick}
              alt=""
              name={`${pet.name}: ${trick.title}`}
              frameClass="frame-trick"
            />
            <figcaption class="tile-foot">
              <span class="tile-title">{trick.title}</span>
              <span class="duration">{formatDuration(trick.durationMs)}</span>
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </section>

  <div class="wrap aside-grid">
    <section class="panel step-panel" aria-labelledby="install">
      <h2 id="install">{pet.builtin ? `Get ${pet.shortName}` : 'How to install'}</h2>
      {pet.builtin ? (
        <ol class="step-list">
          <li>
            <span>
              <a href={SITE.release}>Download DeskPet</a>: the <strong>.dmg</strong> for a Mac (drag
              DeskPet to Applications), or the <strong>windows .zip</strong> (unzip it and run
              DeskPet.exe).
            </span>
          </li>
          <li>
            <span>
              {pet.shortName} is already inside. Pick {pet.shortName} from the DeskPet menu and say
              hello.
            </span>
          </li>
        </ol>
      ) : (
        <ol class="step-list">
          <li>
            <span>
              Have <a href={SITE.release}>DeskPet</a> running: the <strong>.dmg</strong> on macOS or
              the <strong>.zip</strong> on Windows.
            </span>
          </li>
          <li>
            <span>
              Download <strong>{pet.id}.deskpet</strong> with the button above.
            </span>
          </li>
          <li>
            <span>Double-click the file, or drag it and drop it on your pet.</span>
          </li>
          <li>
            <span>{pet.shortName} joins your desktop and stays in the pet list for next time.</span>
          </li>
        </ol>
      )}
    </section>

    <section class="panel step-panel" aria-labelledby="good-to-know">
      <h2 id="good-to-know">Good to know</h2>
      <p class="body-text">
        DeskPet is free, with no ads, no cookies and no accounts. Pets are small modules anyone can
        build, so the shelf keeps growing.
      </p>
      <p class="fine-print">
        <a class="text-link" href="/contribute/">
          Make a pet
        </a>
      </p>
    </section>
  </div>

  <nav class="wrap" aria-label="More pets">
    <div class="pet-nav-grid">
      {previous ? (
        <a class="panel pet-nav-card" href={`/pets/${previous.id}/`} rel="prev">
          <span class="card-meta">Previous pet</span>
          <span class="card-title">{previous.name}</span>
        </a>
      ) : null}
      {next ? (
        <a class="panel pet-nav-card" href={`/pets/${next.id}/`} rel="next">
          <span class="card-meta">Next pet</span>
          <span class="card-title">{next.name}</span>
        </a>
      ) : null}
    </div>
  </nav>

  <script is:inline define:vars={{ id: pet.id }}>
    fetch('/api/visit/' + id, { method: 'POST', keepalive: true }).catch(function () {});
  </script>
</Base>
