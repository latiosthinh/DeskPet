---
import type { GetStaticPaths } from 'astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CatalogueControls from '../../components/CatalogueControls.astro';
import CategoryNav from '../../components/CategoryNav.astro';
import Pagination from '../../components/Pagination.astro';
import PetCard from '../../components/PetCard.astro';
import PetGrid from '../../components/PetGrid.astro';
import Base from '../../layouts/Base.astro';
import { breadcrumbSchema, listingRecords, type ListingRecord } from '../../lib/catalogue';
import { pets } from '../../lib/site';

interface Props {
  record: ListingRecord;
}

export const getStaticPaths = (() =>
  listingRecords()
    .filter((record) => record.scope.kind === 'all')
    .map((record) => ({
      params: { listing: record.page === 1 ? undefined : `page/${record.page}` },
      props: { record },
    }))) satisfies GetStaticPaths;

const { record } = Astro.props;
const { page, pageCount, total } = record;
const items =
  page === 1
    ? [{ label: 'All pets', path: '/pets/' }]
    : [
        { label: 'All pets', path: '/pets/' },
        { label: `Page ${page}`, path: record.path },
      ];
const title = page === 1 ? 'Pets · DeskPet' : `Pets · Page ${page} · DeskPet`;
const description =
  'Browse every DeskPet pixel pet. Search, filter by category, author and type, and find your next desktop companion.' +
  (page > 1 ? ` Page ${page} of ${pageCount}.` : '');
---

<Base title={title} description={description} path={record.path} schema={breadcrumbSchema(items)}>
  <section class="wrap section">
    <Breadcrumbs items={items} />
    <div class="listing-head">
      <h1 class="page-title">Pets</h1>
      <p class="lede">Search and filter the whole shelf, or browse by category.</p>
    </div>
    <CategoryNav />
    <p class="count" data-count aria-live="polite">
      {total} {total === 1 ? 'pet' : 'pets'}
    </p>
    <CatalogueControls />
    <PetGrid pets={record.pets} id="catalogue-grid" />
    <div class="empty-state" data-empty hidden>
      <p class="lede">No pets match your search.</p>
      <button type="button" class="btn btn-secondary" data-reset>
        Reset filters
      </button>
    </div>
    <Pagination record={record} />
    <template id="pet-card-template">
      <PetCard pet={pets[0]} template />
    </template>
  </section>
</Base>

<script>
  import { initCatalogue } from '../../lib/catalogue-client';

  initCatalogue();
</script>

<style>
  .listing-head {
    margin-top: var(--spacing-cozy);
  }

  .count[data-count] {
    margin-top: var(--spacing-snug);
  }

  .empty-state {
    margin-top: var(--spacing-room);
  }

  .empty-state[hidden] {
    display: none;
  }
</style>

<style is:global>
  [hidden] {
    display: none !important;
  }
</style>
