---
import AnimatedMedia from '../components/AnimatedMedia.astro';
import DownloadButtons from '../components/DownloadButtons.astro';
import PetCard from '../components/PetCard.astro';
import Base from '../layouts/Base.astro';
import {
  SITE,
  absoluteUrl,
  authorGroups,
  builtinShortNames,
  listText,
  petImageAlt,
  pets,
  petsById,
} from '../lib/site';

const heroPet = petsById.get('mochi') ?? pets[0];
const groups = authorGroups();
const description =
  'Free pixel pets that live on your desktop. Pick a pet, watch its tricks and add it to DeskPet in one click.';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'DeskPet',
    alternateName: 'DeskPet pixel pets',
    description,
    url: SITE.url,
    downloadUrl: SITE.release,
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'macOS, Windows',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    image: absoluteUrl('/og-default.png'),
    screenshot: absoluteUrl('/og-default.png'),
    sameAs: [SITE.repo],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    url: SITE.url,
    description,
  },
];
---

<Base
  title="DeskPet · tiny pixel pets for your desktop"
  description={description}
  path="/"
  schema={schema}
>
  <section class="hero-glow">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="badge">Free · macOS + Windows</p>
        <h1 class="hero-title">Tiny pixel pets that live on your desktop.</h1>
        <p class="lede">
          They live beside your Dock or on your taskbar, nap when you're busy, cheer when you type
          and do little tricks when you're not looking.
        </p>
        <div class="hero-actions">
          <DownloadButtons />
        </div>
        <p class="fine-print">
          Comes with {listText(builtinShortNames)}. Every other pet is a free one-click add-on
          below.
        </p>
      </div>

      <div class="hero-stage">
        <figure class="panel hero-panel">
          <div class="desktop-scene">
            <div class="desktop-screen" aria-hidden="true">
              <div class="desktop-window">
                <span class="window-bar">
                  <span class="window-dot"></span>
                  <span class="window-dot"></span>
                  <span class="window-dot"></span>
                </span>
                <span class="window-body">
                  <span class="window-line window-line-lg"></span>
                  <span class="window-line"></span>
                  <span class="window-line window-line-sm"></span>
                  <span class="window-cards">
                    <span class="window-card"></span>
                    <span class="window-card"></span>
                  </span>
                </span>
              </div>
              <span class="desktop-dock">
                <span class="dock-icon"></span>
                <span class="dock-icon"></span>
                <span class="dock-icon"></span>
                <span class="dock-icon"></span>
                <span class="dock-icon"></span>
                <span class="dock-icon"></span>
                <span class="dock-icon"></span>
              </span>
            </div>
            <p class="scene-bubble">
              <strong>Hi, I'm {heroPet.shortName}!</strong>
              <span>Mind if I sit by your Dock?</span>
            </p>
            <div class="scene-pet">
              <AnimatedMedia
                media={heroPet.hero}
                alt={petImageAlt(heroPet)}
                name={`${heroPet.name} the cat`}
                eager
                frameClass="frame-scene"
              />
            </div>
          </div>
          <figcaption class="hero-caption">
            <strong>{heroPet.name}</strong> comes with the app and is always ready for a little
            dance.
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="wrap section" aria-labelledby="what">
    <div class="section-head">
      <div>
        <p class="eyebrow">Why DeskPet</p>
        <h2 id="what" class="section-title">
          A tiny friend, always at the edge
        </h2>
      </div>
    </div>
    <ul class="feature-grid">
      <li class="panel feature">
        <span class="badge">Lives beside you</span>
        <h3 class="feature-title">Dock or taskbar</h3>
        <p class="body-text">
          DeskPet sits quietly at the edge of your screen, walks around a little and stays out of
          the way while you work.
        </p>
      </li>
      <li class="panel feature">
        <span class="badge">Little tricks</span>
        <h3 class="feature-title">Reacts to you</h3>
        <p class="body-text">
          Pets nap when you're busy, cheer while you type and have a trick for every mood. Each one
          is hand-drawn pixel art.
        </p>
      </li>
      <li class="panel feature">
        <span class="badge">Always free</span>
        <h3 class="feature-title">One-click add-ons</h3>
        <p class="body-text">
          Every pet is a small <code>.deskpet</code> file that works on Mac and Windows. Download
          one, open it, and it joins your desk.
        </p>
      </li>
    </ul>
  </section>

  <section class="wrap section" id="gallery" aria-labelledby="gallery-title">
    <div class="section-head">
      <div>
        <p class="eyebrow">The shelf</p>
        <h2 id="gallery-title" class="section-title">
          Every pet, by author
        </h2>
        <p class="lede">
          Built-in pets come with the app; everything else is a free download. New community authors
          appear here automatically.
        </p>
      </div>
    </div>

    <nav class="author-nav" aria-label="Authors">
      <span class="author-nav-label">By author</span>
      <ul>
        {groups.map((group) => (
          <li>
            <a class="badge" href={`#author-${group.slug}`}>
              {group.name}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    {groups.map((group) => (
      <section
        class="author-group"
        id={`author-${group.slug}`}
        aria-labelledby={`author-${group.slug}-title`}
      >
        <div class="group-head">
          <h3 id={`author-${group.slug}-title`} class="group-title">
            By {group.name}
          </h3>
          <p class="count">
            {group.pets.length} {group.pets.length === 1 ? 'pet' : 'pets'}
          </p>
        </div>
        <ul class="gallery-grid">
          {group.pets.map((pet) => (
            <li>
              <PetCard pet={pet} />
            </li>
          ))}
        </ul>
      </section>
    ))}
  </section>

  <section class="wrap section" aria-labelledby="make">
    <div class="panel cta-panel">
      <div>
        <h2 id="make">Make your own pet</h2>
        <p>Pets are small modules anyone can build. Draw one, give it tricks and share it here.</p>
      </div>
      <a class="btn btn-secondary" href="/contribute/">
        How to make a pet
      </a>
    </div>
  </section>
</Base>
