---
import Base from '../layouts/Base.astro';
import PetCard from '../components/PetCard.astro';
import { pets } from '../lib/site';

const lost = pets.find((pet) => pet.id === 'mochi') ?? pets[0];
---

<Base
  title="Page not found · DeskPet"
  description="This page wandered off. Meet the pets instead."
  path="/404/"
  noindex
>
  <div class="wrap py-16 sm:py-24">
    <div class="mx-auto max-w-2xl text-center">
      <p class="chip">404</p>
      <h1 class="mt-4 text-4xl font-extrabold sm:text-5xl">This page wandered off.</h1>
      <p class="mt-4 text-lg text-muted">
        Maybe a pet chased it under the taskbar. Everything is still where it should be on the
        shelf.
      </p>
      <p class="mt-6 flex flex-wrap justify-center gap-3">
        <a class="btn btn-primary" href="/">
          See all pets
        </a>
        <a class="btn btn-secondary" href="/contribute/">
          Make a pet
        </a>
      </p>
    </div>
    {lost ? (
      <div class="mx-auto mt-12 max-w-xs">
        <PetCard pet={lost} />
      </div>
    ) : null}
  </div>
</Base>
