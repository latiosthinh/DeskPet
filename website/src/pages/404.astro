---
import Base from '../layouts/Base.astro';
import PetCard from '../components/PetCard.astro';
import { pets } from '../lib/site';

const lost = pets.find((pet) => pet.id === 'mochi') ?? pets[0];
---

<Base
  title="Page not found · DeskPet"
  description="This page wandered off. Meet the pets instead."
  path="/404/"
  noindex
>
  <div class="wrap">
    <div class="not-found">
      <p class="badge">404</p>
      <h1 class="section-title">This page wandered off.</h1>
      <p class="lede">
        Maybe a pet chased it under the taskbar. Everything is still where it should be on the
        shelf.
      </p>
      <p class="not-found-actions">
        <a class="btn btn-primary" href="/">
          See all pets
        </a>
        <a class="btn btn-secondary" href="/contribute/">
          Make a pet
        </a>
      </p>
    </div>
    {lost ? (
      <div class="lost-pet">
        <PetCard pet={lost} />
      </div>
    ) : null}
  </div>
</Base>
