{
  "name": "deskpet-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare-assets": "node scripts/prepare-assets.mjs",
    "dev": "npm run prepare-assets && astro dev",
    "build": "npm run prepare-assets && astro build",
    "preview": "astro preview",
    "lint": "oxlint scripts src/lib tests",
    "format": "oxfmt scripts src/lib src/styles tests astro.config.mjs playwright.config.ts vitest.config.ts package.json tsconfig.json && prettier --write \"src/**/*.astro\"",
    "format:check": "oxfmt --check scripts src/lib src/styles tests astro.config.mjs playwright.config.ts vitest.config.ts package.json tsconfig.json && prettier --check \"src/**/*.astro\"",
    "test:unit": "npm run prepare-assets && vitest run",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:e2e",
    "backend": "node scripts/check-backend.mjs",
    "qa:lighthouse": "node scripts/lighthouse.mjs",
    "qa": "npm run build && npm run lint:tokens && npm run test && npm run backend && npm run qa:contact && npm run qa:lighthouse",
    "lint:tokens": "node scripts/design-tokens.mjs",
    "qa:contact": "node scripts/contact-sheet.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.1",
    "astro": "^7.4.13",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "chrome-launcher": "^1.2.3",
    "lighthouse": "^13.6.0",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "sharp": "^0.35.5",
    "vitest": "^5.1.1",
    "wrangler": "^4.166.0"
  },
  "engines": {
    "node": ">=24.22.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261119.1": true
  }
}
